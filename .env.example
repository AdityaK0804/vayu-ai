# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env

# --- Database ---
# Postgres (production / docker compose). Leave DATABASE_URL unset for local
# development: the backend then uses SQLite at VAYU_DB_PATH (default data/vayu.db).
POSTGRES_USER=vayu
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=vayu
# DATABASE_URL=postgresql://vayu:<password>@127.0.0.1:5432/vayu
# VAYU_DB_PATH=data/vayu.db

# --- Security ---
# Comma-separated admin tokens, each >= 24 chars (generate: python -c "import secrets;print(secrets.token_urlsafe(32))").
# Unset = admin endpoints disabled. List two during rotation.
VAYU_ADMIN_TOKENS=
# Exact browser origins allowed to call the API (no wildcards).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Data sources ---
# Measured CPCB stations (free key at https://explore.openaq.org/register)
# OPENAQ_API_KEY=
# Live satellite fire detections (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# FIRMS_MAP_KEY=

# --- Jobs / runtime ---
# Minute past each hour the ingest worker runs (UTC).
VAYU_INGEST_MINUTE=7
LOG_LEVEL=INFO
# API_PORT=8000

# --- Web ---
# Where Next.js proxies /backend-api (default http://127.0.0.1:8000)
# LIVE_API_PROXY=http://127.0.0.1:8000
