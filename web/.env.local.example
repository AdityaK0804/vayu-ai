# Optional: enables the LLM-backed VAYU assistant via Gemini.
# Without it the assistant still works, answering from the baked data only.
# Free key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: MapTiler key for premium basemaps (dataviz-dark / streets-v2 / hybrid).
# Free tier: https://cloud.maptiler.com/account/keys/
# Without it the app uses OpenFreeMap (dark/streets) + Esri World Imagery (satellite).
NEXT_PUBLIC_MAPTILER_KEY=
